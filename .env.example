# Your ContentWorker install's settings. Copy this file to .env (gitignored) and edit it, then run
# `pnpm contentworker:setup` once and `pnpm contentworker:deploy` for every release. A variable already set in the
# environment wins over this file, so CI can set the same names as repository variables instead.
# Secrets never go here: setup generates them into .secrets/ (back that folder up). See
# docs/deployment.md.

# Required. The admin's host, on a zone in your Cloudflare account. The api is served at
# api.<DOMAIN>, the Delivery API at cdn.<DOMAIN> and published media at media.<DOMAIN>.
DOMAIN=cms.example.com

# Optional: keep the database, media bucket and Durable Objects in a jurisdiction (eu or fedramp).
# Set before the first setup: it can't be changed once they exist.
DATA_JURISDICTION=

# Optional: the most capable model tier the install runs (flagship, balanced or fast). Unset: no cap.
AI_MAX_TIER=
# Optional: whether the AI Gateway keeps a log of each model call (never prompts or answers).
AI_GATEWAY_LOGS=false
# Optional: "mock" runs without Workers AI (models mocked, no AI Gateway or Vectorize index), for
# evaluating the CMS without AI costs.
AI_MODE=
# Optional: offer the enterprise sample starter when a space is created.
DEMO_STARTERS=false

# Optional: admin single sign-on with your OIDC provider. The client secret is a secret: put
# OIDC_CLIENT_SECRET in your secrets file (or a CI secret), not here.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Optional: trust the provider's email_verified claim to link an existing account.
OIDC_TRUST_EMAIL=

# Optional: send mail (workflow notifications, invitations, password reset codes) with Email
# Sending, from an address on a domain onboarded to it.
EMAIL_FROM=
EMAIL_FROM_NAME=

# Optional, for a second install in the same account (a staging copy, say): a name appended to
# every resource (contentworker-api-staging, …) and a rate-limit slot from 2 to 999 that no other
# install in the account uses. Give each install its own settings file:
# `pnpm contentworker:deploy --env-file .env.staging`.
INSTANCE=
RATE_LIMIT_SLOT=1
