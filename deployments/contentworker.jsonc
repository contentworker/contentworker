// contentworker's own deployment at contentworker.app. Its resources keep the base names
// (suffix ""), which are the values in apps/*/wrangler.jsonc. One deployment = one customer: its
// own D1, R2, KV, Vectorize, queues and Workers; spaces and environments live inside its D1.
// scripts/fleet.ts renders each app's wrangler.<id>.json from this file.
//
// Provisioned 2026-10-31. The account's resources from the earlier contentworker-edge stack (its
// KV cache, its event, bulk and agent queues, and its Vectorize index) were renamed out of the way
// to free these names, and nothing in this repo binds them. The AI Gateway "contentworker" is still
// shared with that stack (gateway ids can't be renamed; it's a proxy config).
{
  "id": "contentworker",
  "ring": "internal",
  // Held: run locally for now (docs/development.md); remove to let CI deploy it again.
  "hold": true,
  "slot": 1,
  "domain": "contentworker.app",
  "suffix": "",
  "environment": "production",
  // Set by scripts/provision.sh contentworker (wrangler d1 create).
  "d1Id": "3a8b59b4-0d41-46dc-a460-f24b9e0af765",
  "docs": true,
  // AI Gateway request logs (model, tokens, cost; never prompt or answer).
  "aiGatewayLogs": true,
  "kvId": "9ce1a0ea5a3f4da6b9a415be020b3c81"
}
