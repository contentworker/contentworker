    "secondaryBorderColor": "#868686",
    "tertiaryColor": "#fafafa",
    "tertiaryTextColor": "#0a0a0a",
    "tertiaryBorderColor": "#868686",
    "mainBkg": "#ffffff",
    "nodeBorder": "#868686",
    "nodeTextColor": "#0a0a0a",
    "textColor": "#0a0a0a",
    "titleColor": "#0a0a0a",
    "lineColor": "#868686",
    "defaultLinkColor": "#868686",
    "edgeLabelBackground": "#ffffff",
    "clusterBkg": "#fafafa",
    "clusterBorder": "#cecece",
    "noteBkgColor": "#f5f5f5",
    "noteTextColor": "#0a0a0a",
    "noteBorderColor": "#cecece",
    "actorBkg": "#ffffff",
    "actorBorder": "#868686",
    "actorTextColor": "#0a0a0a",
    "actorLineColor": "#cecece",
    "signalColor": "#868686",
    "signalTextColor": "#0a0a0a",
    "labelBoxBkgColor": "#ffffff",
    "labelBoxBorderColor": "#868686",
    "labelTextColor": "#0a0a0a",
    "loopTextColor": "#0a0a0a",
