{
  "theme": "base",
  "fontFamily": "Inter, ui-sans-serif, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif",
  "themeVariables": {
    "darkMode": false,
    "background": "#ffffff",
    "fontFamily": "Inter, ui-sans-serif, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif",
    "fontSize": "16px",
    "primaryColor": "#f5f5f5",
    "primaryTextColor": "#0a0a0a",
    "primaryBorderColor": "#404040",
    "secondaryColor": "#e5e5e5",
    "secondaryTextColor": "#0a0a0a",
    "secondaryBorderColor": "#404040",
    "tertiaryColor": "#e5e5e5",
    "tertiaryTextColor": "#0a0a0a",
    "tertiaryBorderColor": "#404040",
    "mainBkg": "#f5f5f5",
    "nodeBorder": "#404040",
    "nodeTextColor": "#0a0a0a",
    "textColor": "#0a0a0a",
    "titleColor": "#0a0a0a",
    "lineColor": "#525252",
    "defaultLinkColor": "#525252",
    "edgeLabelBackground": "#ffffff",
    "clusterBkg": "#fafafa",
    "clusterBorder": "#a3a3a3",
    "noteBkgColor": "#f5f5f5",
    "noteTextColor": "#0a0a0a",
    "noteBorderColor": "#a3a3a3",
    "actorBkg": "#f5f5f5",
    "actorBorder": "#404040",
    "actorTextColor": "#0a0a0a",
    "actorLineColor": "#a3a3a3",
    "signalColor": "#525252",
    "signalTextColor": "#0a0a0a",
    "labelBoxBkgColor": "#f5f5f5",
    "labelBoxBorderColor": "#404040",
    "labelTextColor": "#0a0a0a",
    "loopTextColor": "#0a0a0a",
    "activationBkgColor": "#e5e5e5",
    "activationBorderColor": "#404040",
    "sequenceNumberColor": "#ffffff"
