  "flowchart": {
    "curve": "linear",
    "htmlLabels": true,
    "padding": 14
  },
  "sequence": {
    "useMaxWidth": true
  },
  "themeCSS": "g[data-et=\"note\"] rect, .note { fill: #f5f5f5 !important; stroke: #a3a3a3 !important; }"
