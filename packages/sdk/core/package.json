{
  "name": "@contentworker/sdk-core",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://docs.contentworker.app/guides/sdks/",
  "repository": {
    "type": "git",
    "url": "https://github.com/contentworker/contentworker",
    "directory": "packages/sdk/core"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./inline-edit": {
      "types": "./src/inline-edit.ts",
      "default": "./src/inline-edit.ts"
    },
    "./redirects": {
      "types": "./src/redirects.ts",
      "default": "./src/redirects.ts"
    },
    "./webhooks": {
      "types": "./src/webhooks.ts",
      "default": "./src/webhooks.ts"
    },
    "./live-preview": {
      "types": "./src/live-preview.ts",
      "default": "./src/live-preview.ts"
    },
    "./live-preview-host": {
      "types": "./src/live-preview-host.ts",
      "default": "./src/live-preview-host.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/inline-edit.ts src/redirects.ts src/webhooks.ts src/live-preview.ts src/live-preview-host.ts --format esm,cjs && tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --outDir dist --rootDir src",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@contentworker/typescript-config": "workspace:*",
    "jsdom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
