{
  "name": "@contentworker/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Cloudflare runtime every contentworker Worker shares: bindings (env), deployment config, the composition root (wire), ids, metrics, queue message shapes, secrets-at-rest key handling, the Durable Object classes and their clients, and the Workflows clients. Workers import this; they never import each other.",
  "exports": {
    "./auth-rate-limit": "./src/auth-rate-limit.ts",
    "./config": "./src/config.ts",
    "./data-key": "./src/data-key.ts",
    "./do/cost-guard": "./src/do/cost-guard.ts",
    "./do/live-access": "./src/do/live-access.ts",
    "./do/live-hub": "./src/do/live-hub.ts",
    "./do/rate-limiter": "./src/do/rate-limiter.ts",
    "./do/search-shard": "./src/do/search-shard.ts",
    "./editorial-host": "./src/editorial-host.ts",
    "./env": "./src/env.ts",
    "./ids": "./src/ids.ts",
    "./messages": "./src/messages.ts",
    "./metrics": "./src/metrics.ts",
    "./wire": "./src/wire.ts",
    "./workflows": "./src/workflows.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@contentworker/adapters": "workspace:*",
    "@contentworker/agent-runtime": "workspace:*",
    "@contentworker/application": "workspace:*",
    "@contentworker/db": "workspace:*",
    "@contentworker/domain": "workspace:*",
    "@contentworker/ports": "workspace:*",
    "@contentworker/test-kit": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@contentworker/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "license": "Apache-2.0"
}
