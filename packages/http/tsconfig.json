{
  "extends": "@contentworker/typescript-config/base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node", "vitest/globals"]
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*"],
  // Follow-up: the HTTP API and MCP suites build ApiConfig/McpDeps literals that predate the
  // current types (no shared test-config builder). vitest runs them; tsc will once they share one.
  "exclude": ["test/api/**", "test/mcp/**"]
}
