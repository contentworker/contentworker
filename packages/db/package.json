{
  "name": "@contentworker/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "D1 persistence: the sqlite schema, hand-written migrations, and the D1 ContentStore adapter (unit of work, guards, lease-claimed outbox, read-replica sessions).",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./auth": "./src/auth.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@contentworker/domain": "workspace:*",
    "@contentworker/ports": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@contentworker/application": "workspace:*",
    "@contentworker/seed": "workspace:*",
    "@contentworker/test-kit": "workspace:*",
    "@contentworker/typescript-config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "license": "Apache-2.0"
}
