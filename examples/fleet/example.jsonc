// A starting point for a self-hosted deployment, not a live one: its ids are empty and it is held,
// so nothing deploys it. Copy it to deployments/<id>.jsonc (or to the directory FLEET_REGISTRY
// names), change `id`, `domain` and `slot`, run ./scripts/provision.sh <id> (which records d1Id
// and kvId here), then remove `hold`. See docs/deployment.md. Fields: docs/deployment.md "Registry".
{
  "id": "example",
  // staging, internal, canary or general: the order CI deploys in.
  "ring": "staging",
  // Unique per deployment; keeps rate-limit namespaces apart.
  "slot": 1,
  // A domain you control, on Cloudflare. api., cdn. and media. are added in front of it.
  "domain": "cms.example.com",
  // "" keeps the base names in apps/*/wrangler.jsonc; the default is "-<id>".
  "suffix": "",
  "environment": "production",
  "hold": true
}
