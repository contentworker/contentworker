{
  "name": "@contentworker/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The contentworker admin: React Router on Workers. Human sign-in (passwords, two-factor, passkeys, SSO, SCIM), the app shell, and the gateway that forwards API traffic to the api Worker with a signed principal.",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types && react-router typegen",
    "db:migrate:local": "wrangler d1 migrations apply contentworker --local",
    "db:migrate:remote": "wrangler d1 migrations apply contentworker --remote",
    "test": "vitest run",
    "lint": "biome check .",
    "check-types": "react-router typegen && tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@contentworker/db": "workspace:*",
    "@contentworker/domain": "workspace:*",
    "@contentworker/security": "workspace:*",
    "@contentworker/ui": "workspace:*",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource/ibm-plex-mono": "catalog:",
    "@simplewebauthn/browser": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@xyflow/react": "catalog:",
    "ai": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "drizzle-orm": "catalog:",
    "isbot": "catalog:",
    "jose": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "recharts": "catalog:",
    "streamdown": "catalog:",
    "uqr": "catalog:",
    "use-stick-to-bottom": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@contentworker/typescript-config": "workspace:*",
    "@playwright/test": "catalog:",
