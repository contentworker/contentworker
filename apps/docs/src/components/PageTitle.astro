---
/*
 * The page header: the title in Inter 600, set a touch tight, with a muted line under it. That
 * line is the page's `description`, which Starlight otherwise only puts in <meta>.
 */
// biome-ignore lint/correctness/noUnusedVariables: used in the markup
const { title, description } = Astro.locals.starlightRoute.entry.data;
---

<header class="cw-page-header">
  <h1 id="_top">{title}</h1>
  {description && <p class="cw-lede">{description}</p>}
</header>

<script>
  // A table wider than the column scrolls sideways (Starlight sets it `display: block; overflow:
  // auto`). Only a table that actually overflows becomes a tab stop, so a keyboard can scroll it
  // and one that fits adds nothing to the tab order. Rides PageTitle because it renders on every
  // content page.
  const content = document.querySelector('.sl-markdown-content');
  if (content) {
    const mark = () => {
      for (const table of content.querySelectorAll<HTMLTableElement>('table')) {
        if (table.scrollWidth > table.clientWidth + 1) table.tabIndex = 0;
        else table.removeAttribute('tabindex');
      }
    };
    mark();
    new ResizeObserver(mark).observe(content);
  }
</script>
