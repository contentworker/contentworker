---
/*
 * A generated card's title as a real page heading: the id on the heading itself (Starlight's
 * table of contents tracks `h2[id]`/`h3[id]` to mark the current entry) and the same anchor link
 * Starlight adds to Markdown headings, so a node or template can be linked like any section.
 * route-data.ts adds the matching table-of-contents entries.
 */
interface Props {
  id: string;
  level: 2 | 3;
  text: string;
}

// biome-ignore lint/correctness/noUnusedVariables: used in the markup
const { id, level, text } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: used in the markup
const Tag = `h${level}` as const;
---

<div class="sl-heading-wrapper cw-card-heading">
  <Tag id={id}>{text}</Tag><a class="sl-anchor-link" href={`#${id}`}
    ><span aria-hidden="true" class="sl-anchor-icon"
      ><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
        ><path
          d="m12.11 15.39-3.88 3.88a2.52 2.52 0 0 1-3.5 0 2.47 2.47 0 0 1 0-3.5l3.88-3.88a1 1 0 1 0-1.42-1.42l-3.88 3.89a4.48 4.48 0 0 0 6.33 6.33l3.89-3.88a1 1 0 0 0-1.42-1.42m8.58-12.08a4.49 4.49 0 0 0-6.33 0l-3.89 3.88a1 1 0 1 0 1.42 1.42l3.88-3.88a2.52 2.52 0 0 1 3.5 0 2.47 2.47 0 0 1 0 3.5l-3.88 3.88a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l3.88-3.89a4.49 4.49 0 0 0 0-6.33M8.83 15.17a1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.92-4.92a1 1 0 1 0-1.42-1.42l-4.92 4.92a1 1 0 0 0 0 1.42"
        ></path></svg
      ></span
    ><span class="sr-only" data-pagefind-ignore>Section titled “{text}”</span></a
  >
</div>
