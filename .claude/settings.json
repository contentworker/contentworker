{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-generated.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-invariants.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-impact.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/rules-impact.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-drift.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm check-types)",
      "Bash(pnpm test)",
      "Bash(pnpm test:scripts)",
      "Bash(pnpm test:toolkit)",
      "Bash(pnpm turbo run *)",
      "Bash(pnpm --filter @contentworker/design test)",
      "Bash(pnpm --filter @contentworker/db test)",
      "Bash(pnpm --filter @contentworker/engine test)",
      "Bash(pnpm --filter @contentworker/http test)",
      "Bash(pnpm --filter @contentworker/application test)",
      "Bash(pnpm --filter @contentworker/web test)",
      "Bash(pnpm --filter @contentworker/engine check-types)",
      "Bash(pnpm --filter @contentworker/web check-types)",
      "Bash(pnpm --filter @contentworker/engine exec vitest run *)",
      "Bash(pnpm db:migrate:local)",
      "Bash(pnpm db:seed:local)",
      "Bash(pnpm docs:dev)",
      "Bash(pnpm docs:build)",
      "Bash(pnpm --filter @contentworker/docs-site build)",
      "Bash(pnpm --filter @contentworker/docs-site lint)",
      "Bash(pnpm --filter @contentworker/docs-site check-types)",
      "Bash(pnpm sync:theme)",
      "Bash(node scripts/install.ts names *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(.claude/hooks/tests/docs-hooks.test.sh)",
      "Bash(.claude/hooks/tests/guard-hooks.test.sh)",
      "Bash(.claude/scripts/toolkit-check.sh)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh run rerun *)",
      "Bash(gh workflow run *)",
      "Bash(./scripts/setup.sh *)",
      "Bash(scripts/setup.sh *)",
      "Bash(./scripts/setup-code.sh *)",
      "Bash(scripts/setup-code.sh *)",
      "Bash(pnpm cw:setup*)",
      "Bash(pnpm run cw:setup*)"
    ],
    "deny": [
      "Bash(pnpm docs:deploy*)",
      "Bash(pnpm --filter @contentworker/docs-site run deploy*)",
      "Bash(pnpm deploy*)",
      "Bash(pnpm run deploy*)",
      "Bash(wrangler deploy*)",
      "Bash(npx wrangler deploy*)",
      "Bash(wrangler rollback*)",
      "Bash(./scripts/deploy.sh*)",
      "Bash(scripts/deploy.sh*)",
      "Bash(bash scripts/deploy.sh*)",
      "Bash(pnpm cw:deploy*)",
      "Bash(pnpm run cw:deploy*)",
      "Bash(pnpm db:migrate:remote*)",
      "Bash(pnpm --filter @contentworker/web db:migrate:remote*)",
      "Read(/.secrets/**)",
      "Read(/**/.dev.vars)",
      "Read(/**/.env)",
      "Read(/**/.env.*)"
    ]
  }
}
